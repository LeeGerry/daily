---
import DeepView from '../../views/DeepView.astro';
import { issues } from '../../lib/issues';

export function getStaticPaths() {
  return issues.filter((i) => i.en.deep).map((issue) => ({ params: { date: issue.date }, props: { issue } }));
}
---

<DeepView lang="en" issue={Astro.props.issue} />
