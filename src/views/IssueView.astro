---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { t, path, fmtDate, type Locale } from '../i18n';
import { issues, md, type Issue } from '../lib/issues';

interface Props { lang: Locale; issue?: Issue; home?: boolean }
const { lang, issue, home = false } = Astro.props;
const s = t(lang);
const zh = lang === 'zh';

const e = issue?.[lang];
const route = home || !issue ? '/' : `/${issue.date}/`;
const earlier = home ? issues.filter((i) => i !== issue).slice(0, 6) : [];

const jsonld = issue && {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: `Gaiya Daily ${fmtDate(issue.date, lang)}`,
  description: e!.intro,
  datePublished: issue.publishAt,
  inLanguage: zh ? 'zh-Hans' : 'en',
  author: { '@type': 'Person', name: 'Gaiya Lab', url: 'https://gaiya.cc' },
  publisher: { '@type': 'Organization', name: 'Gaiya Lab', url: 'https://gaiya.cc' },
};
---

<Base lang={lang} route={route} section={home ? 'today' : ''} type={issue ? 'article' : 'website'}
      title={issue && !home ? fmtDate(issue.date, lang) : undefined}
      description={e?.intro} date={issue?.publishAt} image={issue && `/cards/${issue.date}/og${zh ? '-zh' : ''}.png`} jsonld={jsonld}>
  {!issue || !e ? (
    <section class="wrap empty"><h1>Gaiya Daily</h1><p class="lede">{s.empty}</p><Subscribe lang={lang} /></section>
  ) : (
    <article class="wrap issue">
      <header class="head">
        <p class="eyebrow crumb">
          <span>{zh ? `第 ${issue.number} 期` : `Issue ${issue.number}`}</span>
          <span aria-hidden="true">/</span>
          <time datetime={issue.date}>{fmtDate(issue.date, lang)}</time>
        </p>
        <h1>{zh ? '今天值得知道的 AI 新闻' : 'What changed in AI today'}</h1>
        <p class="lede">{e.intro}</p>
        <ol class="toc">
          {e.items.map((it) => <li><a href={`#n${it.n}`}>{it.headline}</a></li>)}
        </ol>
      </header>

      {e.items.map((it) => (
        <section class="item" id={`n${it.n}`}>
          <p class="eyebrow num">{String(it.n).padStart(2, '0')} · {it.category}</p>
          <h2>{it.headline}</h2>
          <p class="takeaway">{it.takeaway}</p>
          <div class="prose" set:html={md(it.body)} />
          {it.note && (
            <aside class="note">
              <p class="eyebrow">{s.makerNote}</p>
              <p>{it.note}</p>
            </aside>
          )}
          {e.deep?.n === it.n && (
            <a class="deeplink" href={path(lang, `/${issue.date}/deep/`)}>{s.readDeep} →</a>
          )}
          <p class="sources">
            <span class="eyebrow">{s.sources}</span>
            {it.sources.map((src) => (
              <a href={src.url} rel="noopener">{src.site}</a>
            ))}
          </p>
        </section>
      ))}

      <Subscribe lang={lang} />

      {issue.lab.length > 0 && (
        <section class="lab">
          <p class="eyebrow">{s.fromLab}</p>
          <p class="labnote">{s.fromLabNote}</p>
          <ul>{issue.lab.map((x) => <li><a href={x.url} rel="noopener">{x.title}</a></li>)}</ul>
        </section>
      )}

      {earlier.length > 0 && (
        <section class="earlier">
          <div class="section-head">
            <h2>{s.recent}</h2>
            <a class="eyebrow" href={path(lang, '/archive/')}>{s.allIssues} →</a>
          </div>
          <ul>
            {earlier.map((i) => (
              <li>
                <a href={path(lang, `/${i.date}/`)}>
                  <time datetime={i.date}>{fmtDate(i.date, lang)}</time>
                  <span>{i[lang].items.map((x) => x.headline).slice(0, 2).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  )}
</Base>

<style>
  .empty { padding-block: var(--stack); max-width: 44rem; }
  .issue { max-width: 46rem; padding-top: var(--stack); }
  .head { padding-bottom: 1.6rem; border-bottom: 1px solid var(--line); }
  .crumb { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .crumb span[aria-hidden] { color: var(--line); }
  .head .lede { margin: 1rem 0 0; font-size: 1.12rem; }

  .toc { margin: 1.4rem 0 0; padding-left: 1.3rem; display: grid; gap: 0.3rem; }
  .toc li::marker { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); }
  .toc a { text-decoration: none; }
  .toc a:hover { color: var(--accent); }

  .item { padding-block: 2.4rem; border-bottom: 1px solid var(--line-soft); scroll-margin-top: 4.5rem; }
  .num { color: var(--accent); margin-bottom: 0.55rem; }
  .takeaway {
    margin: 0.7rem 0 1.2rem; font-family: var(--serif); font-size: 1.14rem;
    line-height: 1.5; color: var(--muted);
  }

  .note {
    margin: 1.4rem 0 0; padding: 0.9rem 1.1rem;
    background: var(--card); border: 1px solid var(--line); border-left: 2px solid var(--accent); border-radius: 3px;
  }
  .note .eyebrow { color: var(--accent); margin-bottom: 0.3rem; }
  .note p:last-child { margin: 0; }

  .deeplink {
    display: inline-block; margin-top: 1.2rem; padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent); border-radius: 999px; color: var(--accent);
    text-decoration: none; font-size: 0.92rem;
  }
  .deeplink:hover { background: var(--accent); color: var(--accent-on); }

  .sources { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.9rem; margin: 1.3rem 0 0; font-size: 0.86rem; }
  .sources a { color: var(--muted); }
  .sources a:hover { color: var(--accent); }

  .lab { margin-top: 2.6rem; padding: 1.2rem 1.3rem; background: var(--card-2); border: 1px solid var(--line); border-radius: 4px; }
  .labnote { color: var(--muted); font-size: 0.9rem; margin: 0.3rem 0 0.6rem; }
  .lab ul { margin: 0; padding-left: 1.1rem; }
  .lab a { color: var(--accent); }

  .earlier { margin-top: var(--stack); }
  .earlier ul { list-style: none; margin: 0; padding: 0; }
  .earlier a { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line-soft); text-decoration: none; }
  .earlier time { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
  .earlier a:hover span { color: var(--accent); }
  @media (max-width: 36rem) { .earlier a { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
