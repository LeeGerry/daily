---
import { t, path, EMAIL } from '../i18n';
const { lang = 'en' } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
const zh = lang === 'zh';
---

<footer>
  <div class="wrap inner">
    <div class="col">
      <p class="eyebrow">Gaiya Daily</p>
      {zh ? (
        <p class="note">
          由 <a href="https://gaiya.cc" rel="noopener">Gaiya Lab</a> 出品,一个人的应用工作室。
          AI 帮忙读原文、起草稿,每一条都由作者本人审过才发。
        </p>
      ) : (
        <p class="note">
          Made by <a href="https://gaiya.cc" rel="noopener">Gaiya Lab</a>, a one-person app studio.
          AI helps read the sources and draft; every item is checked by the maker before it goes out.
        </p>
      )}
    </div>

    <div class="col links">
      <p class="eyebrow">{zh ? '栏目' : 'Read'}</p>
      <a href={path(lang, '/')}>{s.nav.today}</a>
      <a href={path(lang, '/archive/')}>{s.nav.archive}</a>
      <a href={path(lang, '/about/')}>{s.nav.about}</a>
    </div>

    <div class="col links">
      <p class="eyebrow">{zh ? '关注' : 'Follow'}</p>
      <a href={zh ? '/zh/rss.xml' : '/rss.xml'}>RSS</a>
      <a href="https://x.com/gaiya_l" rel="noopener">X @gaiya_l</a>
      <a href="https://teardown.gaiya.cc" rel="noopener">Teardown</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </div>

  <div class="wrap base">
    <span>© {year} Gaiya Lab</span>
    <span><a href="/llms.txt">llms.txt</a> · <a href="/sitemap-index.xml">Sitemap</a></span>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: var(--stack); padding-top: 2.2rem; }
  .inner { display: grid; gap: 2rem; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); }
  .note { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.9rem; max-width: 30rem; }
  .note a { color: var(--accent); }
  .links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; }
  .links a { color: var(--muted); font-size: 0.9rem; text-decoration: none; }
  .links a:hover { color: var(--accent); }
  .links .eyebrow { margin-bottom: 0.35rem; }
  .base {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 2.4rem; padding-block: 1rem 2.4rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono); font-size: 0.68rem; color: var(--muted);
  }
  .base a { color: inherit; text-decoration: none; }
  .base a:hover { color: var(--accent); }
  @media (max-width: 42rem) { .inner { grid-template-columns: 1fr 1fr; } .col:first-child { grid-column: 1 / -1; } }
</style>
