---
/**
 * 邮件订阅框。提交给本站 Worker 的 /api/subscribe,由它写进 Resend 对应语言的名单。
 * name="website" 是给机器人填的陷阱字段,真人看不到。
 */
import { t, path, EMAIL, type Locale } from '../i18n';

// 关掉就不显示订阅框(比如 Resend 出问题时)
const ENABLED = true;

interface Props { lang: Locale }
const { lang } = Astro.props;
const s = t(lang).sub;
---

{ENABLED && <section class="sub" aria-labelledby="sub-title">
  <h2 id="sub-title">{s.title}</h2>
  <p class="lede">{s.lede}</p>
  <form method="post" action="/api/subscribe" data-sending={s.sending} data-done={s.done} data-failed={s.failed}>
    <input type="hidden" name="lang" value={lang} />
    <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="sr" for="sub-email">{s.placeholder}</label>
    <input id="sub-email" type="email" name="email" required autocomplete="email" placeholder={s.placeholder} />
    <button type="submit">{s.button}</button>
  </form>
  <p class="status" role="status" aria-live="polite"></p>
  <p class="fine">{s.fine} <a href={`mailto:${EMAIL}?subject=Gaiya%20Daily`}>{EMAIL}</a>. <a href={path(lang, '/about/#privacy')}>{s.privacy}</a></p>
</section>}

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.sub form')) {
    const status = form.nextElementSibling as HTMLElement;
    const button = form.querySelector('button')!;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      button.disabled = true;
      status.textContent = form.dataset.sending!;
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        status.textContent = form.dataset.done!;
        form.hidden = true;
      } catch {
        status.textContent = form.dataset.failed!;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .sub {
    margin-top: 2.6rem; padding: 1.4rem 1.4rem 1.2rem;
    background: var(--card); border: 1px solid var(--line); border-radius: 4px;
  }
  .sub h2 { font-size: 1.35rem; margin: 0; }
  .sub .lede { margin: 0.5rem 0 1rem; color: var(--muted); font-size: 0.98rem; }
  form { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  input[type='email'] {
    flex: 1 1 14rem; min-width: 0; padding: 0.6rem 0.8rem; font: inherit; color: var(--ink);
    background: var(--ground); border: 1px solid var(--line); border-radius: 999px;
  }
  input[type='email']:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  button {
    padding: 0.6rem 1.2rem; font: inherit; font-size: 0.95rem; cursor: pointer;
    color: var(--accent-on); background: var(--accent); border: 1px solid var(--accent); border-radius: 999px;
  }
  button:disabled { opacity: 0.6; cursor: wait; }
  .status { margin: 0.7rem 0 0; min-height: 1.4em; font-size: 0.9rem; color: var(--accent); }
  .fine { margin: 0.5rem 0 0; font-size: 0.82rem; color: var(--muted); }
  .fine a { color: var(--muted); }
  form[hidden] { display: none; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
